# Site configuration: copy to config/hosts.env (not committed; see .gitignore) and fill in.
# Nothing in the harness hard-codes a host name, user or address; these are the only site values.

# Optional overrides of config/pins.env (read before it):
# FV_ROOT=$HOME/fv-harness    # toolchain, work, task and run directories
# FV_CPUSET=4-15              # cores the gate, builds and fuzzer may use (default: all)
# FV_JOBS=8                   # parallel jobs for builds and checkers (default: nproc)
# FV_CMAKE_ARGS="-DDEPS_INCLUDE_DIRS=/opt/deps/include -DDEPS_LIBRARIES=/opt/deps/lib/libx.a"
#                             # site defaults for project CMake definitions (-D only; run_fuzz.sh --cmake-arg)
# FV_REQUIRE_LANGS=rust       # languages whose controls must run here: a missing toolchain is then
#                             # a failure, not a SKIP (set it on the gate host; public CI keeps none)
# ONE RULE for every script (they all load this file through scripts/lib.sh): an EXPORTED
# environment variable overrides any value set here; this file only supplies defaults. Export it,
# or prefix the command (FV_CPUSET=4-7 fuzz/run_fuzz.sh ...): a plain assignment on its own line
# (FV_CPUSET=4-7, then the command) is not exported and is never seen. Control c31 checks this.
# So this file cannot ENFORCE FV_REQUIRE_LANGS against whoever runs the
# suite: anyone can export FV_REQUIRE_LANGS= to turn the requirement off. It guards the gate
# operator's own runs against a missing toolchain; it is not a control against the operator.

# ssh alias of the gate host: Lean toolchain, sandbox, checkers and fuzzer run there.
# Agent-side commands in agent-config/ reach it as `ssh $FV_GATE_HOST ...`
# (settings.synthesis.json: replace __GATE_HOST__).
FV_GATE_HOST=gate

# Optional: a remote GPU host for the Tier-2 "main" stage (prover/remote/): the ssh destination
# (user@host), and the loopback ports of its instances (one per GPU). prover/relay/ forwards them.
FV_REMOTE_GPU_HOST=fvtier2@gpu-host
FV_TIER2_PORTS="18100"
