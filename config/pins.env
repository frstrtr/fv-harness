# Pinned toolchain and checker locations for the verification gate (sourced by scripts/lib.sh).
# Paths are on the gate host. Override FV_ROOT to relocate the whole tree. Site values (FV_ROOT,
# CPU caps, host aliases) go in config/hosts.env, which is read first when it exists.
_fv_hosts="$(dirname "${BASH_SOURCE[0]}")/hosts.env"
# An exported environment variable overrides the site file (the file only supplies defaults).
if [ -f "$_fv_hosts" ]; then
  _fv_env=$(declare -px 2>/dev/null)
  # shellcheck source=/dev/null
  . "$_fv_hosts"
  eval "$_fv_env" 2>/dev/null
  unset _fv_env
fi
unset _fv_hosts

FV_ROOT="${FV_ROOT:-$HOME/fv-harness}"

# Lean release toolchain (elan, own ELAN_HOME). Release builds bundle leanexport, leanchecker,
# leanchecker-paranoid, lean4lean, nanoda_bin, con-leche (b46cb0e6) and con-ron (cb54c9a4).
ELAN_HOME="$FV_ROOT/elan"
LEAN_VERSION="v4.36.0"
LEAN_COMMIT="611c117bfaf7b7ae1cfcf246ce6fba31e8f509e9"
LEAN_TC="$ELAN_HOME/toolchains/leanprover--lean4---v4.36.0"

# Standalone con-leche built from master: the only con-* binary with two-export --compare.
CON_LECHE_MASTER_SHA="5ea446d5c79d23ef1f954215d094db2162f1ab6f"
CON_LECHE_MASTER_BIN="$FV_ROOT/src/con-leche-master/.lake/build/bin/con-leche"

# solc for --lang evm (official static Linux build; GPL-3.0), user-local. Any other binary is refused.
FV_SOLC_VERSION="0.8.39"
FV_SOLC_SHA256="b8b0642d46838575d3177628b685564b52f51f2aee546cb4dce781951d23c666"

# TRON-TVM reference executor for --lang tron-tvm (user-local under $FV_TRON_TVM_HOME, default $FV_ROOT/tron-tvm):
# java-tron built from source at the tag (its own TRON-TVM, run offline), a Temurin JDK 8, and the TRON
# solc fork. Any other java-tron commit, a modified java-tron tree or another solc is refused.
FV_JAVA_TRON_COMMIT="4e8389f159d0782f1ebcd9dab2fd88388c0e6fe9"   # GreatVoyage-v4.8.2.4
FV_TRON_TVM_JDK="jdk8u514-b01"                                        # Temurin 8, tarball sha256 27eda854...5d095
FV_TRON_SOLC_VERSION="0.5.18"
FV_TRON_SOLC_SHA256="27ebd5dcc78f99e60d138cebcf642dc01dcd3cd7d4c7ce24569bbdd136cdbc27"
# The executed build, pinned (run_fuzz.sh refuses any other, and refuses to run without these):
# the sha256 of the classpath manifest (every entry under $FV_TRON_TVM_HOME, jars by sha256, directories
# by the sha256 of their file list, paths relative to the home), of the whole JDK tree (files and each
# symbolic link's target), and of the node
# config java-tron loads (config-test.conf, as the driver reads it from the classpath). Values from the
# reference build on the reference host; a rebuild that changes any byte needs new values here.
FV_TRON_TVM_CLASSPATH_SHA256="2a805b823974e2e8b256c1d68f55eae6f015bcc382ba9d8206add1f962717d47"
FV_TRON_TVM_JDK_TREE_SHA256="4fcce0fd4c400efe8eb1d21edf765dbab41a90bcde048310afbce1829e3dba64"
FV_TRON_TVM_NODE_CONFIG_SHA256="1d5385f6ef43a573b86f35d988d490733664d57e784af24dd7a9397b725d5702"

# Resource caps. Default: every CPU, nice 10. On a shared workstation, reserve cores in
# config/hosts.env (the reference host uses FV_CPUSET=4-15, FV_JOBS=8 on 16 threads).
FV_CPUSET="${FV_CPUSET:-0-$(( $(nproc) - 1 ))}"
FV_NICE="${FV_NICE:-10}"
FV_JOBS="${FV_JOBS:-$(nproc)}"

# Axioms a solution may rest on. Must match permitted_axioms in every comparator.json.
FV_PERMITTED_AXIOMS="propext Quot.sound Classical.choice"
