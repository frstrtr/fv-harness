# Tier-2 prover cascade. Moving an endpoint is a change to this file only: every stage is a
# chat-completions-compatible URL plus its parallel slots.

# ---- client (dispatch_local_prover) ----
# Stages run in order. A stage whose endpoint does not answer is skipped without spending budget;
# the first stage that closes the lemma ends the cascade. TIER2_<STAGE>_<KEY> overrides
# TIER2_<KEY> for BASE_URL, MODEL, SLOTS, BUDGET, ROUNDS, MAX_TOKENS, TEMPERATURE, TOP_P,
# TIMEOUT, PROMPT. A stage without its own BUDGET takes the task's K (--budget).
# Fallback when the remote GPU host is unavailable: TIER2_CASCADE="fast local".
TIER2_CASCADE="${TIER2_CASCADE:-fast main}"

# Defaults, and the "main" stage: Goedel-Prover-V2-8B Q6_K on a remote 12 GB GPU (prover/remote/),
# reached from the gate host through the relay at 127.0.0.1:18100 (README "Production Tier 2").
# With several GPUs, list one endpoint per instance: "http://127.0.0.1:18100/v1 http://127.0.0.1:18101/v1".
TIER2_BASE_URL="${TIER2_BASE_URL:-http://127.0.0.1:18100/v1}"
TIER2_MODEL="${TIER2_MODEL:-goedel-prover-v2-8b}"
TIER2_SLOTS="${TIER2_SLOTS:-4}"            # concurrent requests = server parallel slots
TIER2_MAX_TOKENS="${TIER2_MAX_TOKENS:-6144}"
TIER2_TEMPERATURE="${TIER2_TEMPERATURE:-0.9}"
TIER2_TOP_P="${TIER2_TOP_P:-0.95}"
TIER2_TIMEOUT="${TIER2_TIMEOUT:-1200}"     # seconds per request
TIER2_ROUNDS="${TIER2_ROUNDS:-3}"          # compiler-feedback repair rounds per sample
TIER2_PROMPT="${TIER2_PROMPT:-cot}"        # cot: proof plan, then code; plain: code only

# "fast" stage: DeepSeek-Prover-V2-7B Q4_K_M on the gate host (prover/tier2_server.sh start fast), a
# cheap non-reasoning first pass: code-only prompt, short replies, its own small budget.
TIER2_FAST_BASE_URL="${TIER2_FAST_BASE_URL:-http://127.0.0.1:8082/v1}"
TIER2_FAST_MODEL="${TIER2_FAST_MODEL:-deepseek-prover-v2-7b}"
TIER2_FAST_SLOTS="${TIER2_FAST_SLOTS:-1}"
TIER2_FAST_BUDGET="${TIER2_FAST_BUDGET:-4}"
TIER2_FAST_ROUNDS="${TIER2_FAST_ROUNDS:-1}"
TIER2_FAST_MAX_TOKENS="${TIER2_FAST_MAX_TOKENS:-1536}"
TIER2_FAST_TEMPERATURE="${TIER2_FAST_TEMPERATURE:-1.0}"
TIER2_FAST_PROMPT="${TIER2_FAST_PROMPT:-plain}"

# "local" stage (fallback, not in the default cascade): Goedel-Prover-V2-8B IQ4_XS on the gate host
# (prover/tier2_server.sh start local), 1 slot.
TIER2_LOCAL_BASE_URL="${TIER2_LOCAL_BASE_URL:-http://127.0.0.1:8081/v1}"
TIER2_LOCAL_SLOTS="${TIER2_LOCAL_SLOTS:-1}"

# Escalation budget: defaults for new [FORMAL] tasks; each task keeps its own copy (formal_task.py
# init/set). Dry run 02 spent 48 of 53 minutes on one leaf at 2 attempts x 8 samples that Tier 1
# then split in seconds, so the default walls after 1 attempt x 4 samples (K applies to "main").
TIER2_BUDGET="${TIER2_BUDGET:-4}"          # samples per attempt (K)
TIER2_MAX_ATTEMPTS="${TIER2_MAX_ATTEMPTS:-1}"  # attempts per stub before the wall event
TIER2_SAME_FAILURE_WALL="${TIER2_SAME_FAILURE_WALL:-1}"  # 1: wall at once when all samples fail alike

# ---- servers on the gate host (reference: RTX 3060 Laptop 6 GB, shared with a desktop) ----
# prover/tier2_server.sh start fast|local. One profile at a time: the card holds one model.
TIER2_SERVER_BIN="${TIER2_SERVER_BIN:-$FV_ROOT/src/llama.cpp/build/bin/llama-server}"
TIER2_LLAMA_CPP_TAG="b12387"               # a956a852c9c8bc1fb07206364838ddef299178c0
TIER2_HOST="127.0.0.1"
TIER2_CPUSET="${TIER2_CPUSET:-12-15}"
TIER2_THREADS="${TIER2_THREADS:-4}"
# No hard RAM cap: see prover/tier2_server.sh (measured peak 4.5 GB host RAM).

# fast: DeepSeek-Prover-V2-7B, community GGUF (README "Tier-2 model provenance"). Llama
# architecture without grouped-query attention, so the KV cache is 4x Goedel's per token: q4_0.
TIER2_SRV_FAST_GGUF="$FV_ROOT/models/DeepSeek-Prover-V2-7B.Q4_K_M.gguf"
TIER2_SRV_FAST_SHA256="1bcf1bd12cc8638c957a41818548019a686e37dadd3aa44cdf3a78e443182a44"
TIER2_SRV_FAST_ALIAS="deepseek-prover-v2-7b"
TIER2_SRV_FAST_PORT=8082
TIER2_SRV_FAST_CTX=6144
TIER2_SRV_FAST_PARALLEL=1
TIER2_SRV_FAST_CACHE=q4_0

# local: Goedel-Prover-V2-8B IQ4_XS (the dry-run model).
TIER2_SRV_LOCAL_GGUF="$FV_ROOT/models/Goedel-Prover-V2-8B.IQ4_XS.gguf"
TIER2_SRV_LOCAL_SHA256="e948e3a8a8077a3a4bb50d0291d394b291f6eaf8fb8b73d909e9f0b1b5352602"
TIER2_SRV_LOCAL_ALIAS="goedel-prover-v2-8b"
TIER2_SRV_LOCAL_PORT=8081
TIER2_SRV_LOCAL_CTX=8192                   # tokens across all slots; q8_0 KV ~ 0.6 GB at 8192
TIER2_SRV_LOCAL_PARALLEL=1
TIER2_SRV_LOCAL_CACHE=q8_0

# ---- server on the remote GPU host (the "main" stage): prover/remote/fv-tier2@.service.in ----
TIER2_REMOTE_GGUF_SHA256="43a23c094fd495304726f1471a9e10ca48997573278e306a555be1d3371aff3a"  # Goedel-Prover-V2-8B.Q6_K.gguf
