{
  "permissions": {
    "allow": [
      "mcp__lean-lsp__lean_goal",
      "mcp__lean-lsp__lean_term_goal",
      "mcp__lean-lsp__lean_diagnostic_messages",
      "mcp__lean-lsp__lean_hover_info",
      "mcp__lean-lsp__lean_file_outline",
      "mcp__lean-lsp__lean_completions",
      "mcp__lean-lsp__lean_multi_attempt",
      "mcp__lean-lsp__lean_local_search",
      "mcp__lean-lsp__lean_declaration_file",
      "mcp__lean-lsp__lean_references",
      "mcp__lean-lsp__lean_code_actions",
      "mcp__lean-lsp__lean_verify",
      "mcp__lean-lsp__lean_minimal_hypotheses"
    ],
    "deny": [
      "Edit(spec/challenge/**)",
      "Write(spec/challenge/**)",
      "Edit(lakefile.toml)",
      "Edit(lakefile.lean)",
      "Edit(lean-toolchain)",
      "Edit(lake-manifest.json)",
      "Edit(comparator.json)",
      "Write(lakefile.toml)",
      "Write(lakefile.lean)",
      "Write(lean-toolchain)",
      "Write(lake-manifest.json)",
      "Write(comparator.json)",
      "Bash(git commit:*)",
      "Bash(git push:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ssh -T -o BatchMode=yes __GATE_HOST__ '~/fv-harness/harness/scripts/preflight_lake_build.sh __PROJECT__'",
            "timeout": 900
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "ssh -T -o BatchMode=yes __GATE_HOST__ '~/fv-harness/harness/scripts/preflight_lake_build.sh __PROJECT__' >&2",
            "timeout": 900
          }
        ]
      }
    ]
  }
}
