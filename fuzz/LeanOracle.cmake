# LeanOracle.cmake — link production C++ against functions exported from a Lean spec project.
#
# lean_oracle_library(<name>
#     LEAN_PROJECT <dir>      # trusted copy of the spec project (spec/challenge only)
#     LEAN_BIN_DIR <dir>      # toolchain bin/ holding lake and lean
#     PACKAGE <lake package>  # e.g. fv_conservation
#     LEAN_LIB <lean_lib>     # library whose static facet holds the @[export] functions
#     INIT_MODULES <mod>...)  # modules to initialise (they initialise their imports)
#
#   Builds `<LEAN_LIB>:static` with lake and generates fv_oracle_init(). The result is a static
#   target <name> that carries the Lean headers, the runtime (libleanshared) and an rpath.
#
# add_diff_fuzzer(<name> BINDING <header> ORACLE <oracle target> [INCLUDE_DIRS <dir>...]
#                 [SOURCES <file>...] [LINK_LIBRARIES <target or library>...])
#
#   A libFuzzer + ASan + UBSan executable built from diff_oracle_template.cpp. Header-only
#   production code needs INCLUDE_DIRS only. Compiled production code: list its translation units
#   in SOURCES (they are built with the same sanitizers) and/or its libraries in LINK_LIBRARIES
#   (prefer libraries built with -fsanitize=address,undefined). Also defines <name>_classify, the
#   labels-only build (fv_classify.hpp) with the classes.hpp found next to the binding header; the
#   verdict binary <name> contains no classify code and no classes.

set(FV_DIFF_TEMPLATE "${CMAKE_CURRENT_LIST_DIR}/diff_oracle_template.cpp")

function(_lean_mangle out name)  # Lean C name mangling for module and package names
  string(REPLACE "_" "__" m "${name}")
  string(REPLACE "." "_" m "${m}")
  set(${out} "${m}" PARENT_SCOPE)
endfunction()

function(lean_oracle_library name)
  cmake_parse_arguments(A "" "LEAN_PROJECT;LEAN_BIN_DIR;PACKAGE;LEAN_LIB" "INIT_MODULES" ${ARGN})
  foreach(req LEAN_PROJECT LEAN_BIN_DIR PACKAGE LEAN_LIB INIT_MODULES)
    if(NOT A_${req})
      message(FATAL_ERROR "lean_oracle_library: ${req} is required")
    endif()
  endforeach()
  execute_process(COMMAND "${A_LEAN_BIN_DIR}/lean" --print-prefix
                  OUTPUT_VARIABLE prefix OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
  _lean_mangle(pkg "${A_PACKAGE}")
  set(lib "${A_LEAN_PROJECT}/.lake/build/lib/lib${pkg}_${A_LEAN_LIB}.a")
  file(GLOB_RECURSE lean_srcs CONFIGURE_DEPENDS "${A_LEAN_PROJECT}/spec/challenge/*.lean")
  add_custom_command(
    OUTPUT "${lib}"
    COMMAND "${A_LEAN_BIN_DIR}/lake" build "${A_LEAN_LIB}:static"
    WORKING_DIRECTORY "${A_LEAN_PROJECT}"
    DEPENDS ${lean_srcs}
    COMMENT "lake build ${A_LEAN_LIB}:static (Lean oracle)"
    VERBATIM)
  add_custom_target(${name}_lake DEPENDS "${lib}")

  set(decls "")
  set(calls "")
  foreach(mod ${A_INIT_MODULES})
    _lean_mangle(m "${mod}")
    string(APPEND decls "lean_object* initialize_${pkg}_${m}(uint8_t builtin);\n")
    string(APPEND calls
      "  r = initialize_${pkg}_${m}(1);\n"
      "  if (!lean_io_result_is_ok(r)) { lean_io_result_show_error(r); lean_dec_ref(r); return 1; }\n"
      "  lean_dec_ref(r);\n")
  endforeach()
  set(shim "${CMAKE_CURRENT_BINARY_DIR}/${name}_init.cpp")
  file(WRITE "${shim}"
    "// Generated by LeanOracle.cmake. Initialises the oracle modules; since Lean 4.36 each\n"
    "// module initializer starts the runtime itself (lean_initialize_runtime_module).\n"
    "#include <lean/lean.h>\n"
    "extern \"C\" {\n${decls}"
    "int fv_oracle_init(void) {\n"
    "  lean_object* r;\n${calls}"
    "  lean_io_mark_end_initialization();\n"
    "  return 0;\n}\n}\n")

  add_library(${name} STATIC "${shim}")
  add_dependencies(${name} ${name}_lake)
  target_include_directories(${name} PUBLIC "${prefix}/include")
  target_link_libraries(${name} PUBLIC "${lib}" "${prefix}/lib/lean/libleanshared.so")
  target_link_options(${name} PUBLIC "-Wl,-rpath,${prefix}/lib/lean")
  set_target_properties(${name} PROPERTIES FV_LEAN_LIB "${lib}" FV_LEAN_PREFIX "${prefix}")
endfunction()

# lean_oracle_shared(<name> ORACLE <lean_oracle_library target> [BYTES <export>...])
#
#   The same oracle as one shared library (lib<name>.so: the Lean modules, the generated
#   fv_oracle_init() and an rpath to the Lean runtime), for languages that bind through a C FFI
#   (Rust build.rs, Python ctypes, Go cgo, Java, JS). It is built from the same trusted copy.
#   BYTES names exported Lean functions of type `(input : ByteArray) -> ByteArray`. Lean (4.36)
#   refuses borrow annotations on @[export] declarations, so the function OWNS its input: the
#   wrapper hands it over and does not release it. For each, a C wrapper is generated:
#     int fv_bytes_<export>(const uint8_t* in, size_t n, uint8_t* out, size_t expect, size_t* got)
#   It copies `in` into a fresh ByteArray, passes it (with its reference) to the function, and copies
#   the result to `out` only if the result is a ByteArray of exactly `expect` bytes; it then releases
#   the result, which it owns. Returns 0 on success, 1 if the length differs (*got = the length), 2 if the
#   result is not a ByteArray. Any non-zero return is a harness ERROR, never a truncated value.
#   Without BYTES the generated library is unchanged.
function(lean_oracle_shared name)
  cmake_parse_arguments(A "" "ORACLE" "BYTES" ${ARGN})
  if(NOT A_ORACLE)
    message(FATAL_ERROR "lean_oracle_shared: ORACLE is required")
  endif()
  get_target_property(lakelib ${A_ORACLE} FV_LEAN_LIB)
  get_target_property(prefix ${A_ORACLE} FV_LEAN_PREFIX)
  set(stub "${CMAKE_CURRENT_BINARY_DIR}/${name}_stub.c")
  file(WRITE "${stub}" "/* Generated by LeanOracle.cmake: the oracle as a shared library. */\n")
  if(A_BYTES)
    file(APPEND "${stub}" "#include <lean/lean.h>\n#include <stdint.h>\n#include <string.h>\n")
    foreach(fn ${A_BYTES})
      if(NOT fn MATCHES "^[A-Za-z_][A-Za-z0-9_]*$")
        message(FATAL_ERROR "lean_oracle_shared: BYTES name '${fn}' is not a C identifier")
      endif()
      file(APPEND "${stub}"
        "lean_object* ${fn}(lean_obj_arg input);\n"
        "/* takes one reference to a (a ByteArray); the export consumes it */\n"
        "int fv_bytes_obj_${fn}(lean_object* a, uint8_t* out, size_t expect, size_t* got) {\n"
        "  lean_object* r = ${fn}(a);  /* the function owns and releases a */\n"
        "  /* a scalar (boxed) result is not an object: check that first; then a ByteArray of 1-byte elements */\n"
        "  if (lean_is_scalar(r) || !lean_is_sarray(r) || lean_sarray_elem_size(r) != 1) {\n"
        "    if (!lean_is_scalar(r)) lean_dec(r);\n"
        "    *got = 0; return 2;\n  }\n"
        "  size_t m = lean_sarray_size(r);\n"
        "  *got = m;\n"
        "  if (m != expect) { lean_dec(r); return 1; }\n"
        "  if (m) memcpy(out, lean_sarray_cptr(r), m);\n"
        "  lean_dec(r);\n"
        "  return 0;\n}\n"
        "int fv_bytes_${fn}(const uint8_t* in, size_t n, uint8_t* out, size_t expect, size_t* got) {\n"
        "  lean_object* a = lean_alloc_sarray(1, n, n);\n"
        "  if (n) memcpy(lean_sarray_cptr(a), in, n);\n"
        "  return fv_bytes_obj_${fn}(a, out, expect, got);\n}\n")
    endforeach()
  endif()
  add_library(${name} SHARED "${stub}")
  add_dependencies(${name} ${A_ORACLE})
  target_link_libraries(${name} PRIVATE "-Wl,--whole-archive" "$<TARGET_FILE:${A_ORACLE}>" "${lakelib}"
                        "-Wl,--no-whole-archive" "${prefix}/lib/lean/libleanshared.so")
  target_link_options(${name} PRIVATE "-Wl,-rpath,${prefix}/lib/lean")
  set_target_properties(${name} PROPERTIES POSITION_INDEPENDENT_CODE ON)
  if(A_BYTES)
    target_include_directories(${name} PRIVATE "${prefix}/include")
  endif()
endfunction()

function(_fv_diff_target tname)  # _fv_diff_target(<target> <binding> <oracle> <classify> ...)
  set(binding "${ARGV1}")
  set(oracle "${ARGV2}")
  set(classify "${ARGV3}")
  cmake_parse_arguments(B "" "" "INCLUDE_DIRS;SOURCES;LINK_LIBRARIES" ${ARGN})
  add_executable(${tname} "${FV_DIFF_TEMPLATE}" ${B_SOURCES})
  target_compile_features(${tname} PRIVATE cxx_std_17)
  target_compile_definitions(${tname} PRIVATE "DIFF_ORACLE_BINDING=\"${binding}\"")
  if(classify)
    target_compile_definitions(${tname} PRIVATE FV_CLASSIFY_BUILD=1)
    get_filename_component(_fv_bdir "${binding}" DIRECTORY)
    if(EXISTS "${_fv_bdir}/classes.hpp")
      target_compile_definitions(${tname} PRIVATE "FV_CLASSES_HEADER=\"${_fv_bdir}/classes.hpp\"")
    endif()
  endif()
  target_include_directories(${tname} PRIVATE ${B_INCLUDE_DIRS})
  set(san -fsanitize=fuzzer,address,undefined)
  target_compile_options(${tname} PRIVATE ${san} -fno-sanitize-recover=all -g -O1)
  target_link_options(${tname} PRIVATE ${san})
  target_link_libraries(${tname} PRIVATE ${oracle} ${B_LINK_LIBRARIES})
endfunction()

# Two executables: <name>, the verdict binary (no classify code at all), and <name>_classify,
# used only by the labels-only replay after a campaign.
function(add_diff_fuzzer name)
  cmake_parse_arguments(A "" "BINDING;ORACLE" "INCLUDE_DIRS;SOURCES;LINK_LIBRARIES" ${ARGN})
  if(NOT A_BINDING OR NOT A_ORACLE)
    message(FATAL_ERROR "add_diff_fuzzer: BINDING and ORACLE are required")
  endif()
  foreach(variant IN ITEMS 0 1)
    if(variant)
      set(tname ${name}_classify)
    else()
      set(tname ${name})
    endif()
    _fv_diff_target(${tname} "${A_BINDING}" ${A_ORACLE} ${variant}
                    INCLUDE_DIRS ${A_INCLUDE_DIRS} SOURCES ${A_SOURCES} LINK_LIBRARIES ${A_LINK_LIBRARIES})
  endforeach()
endfunction()
